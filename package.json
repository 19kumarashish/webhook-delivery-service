
{
  "name": "webhook-delivery-service",
  "version": "1.0.0",
  "description": "A reliable asynchronous webhook delivery service built with Node.js, TypeScript, PostgreSQL, Redis, and BullMQ.",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/delivery.worker.ts",
    "receiver": "node receiver.cjs",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/delivery.worker.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "webhooks",
    "nodejs",
    "typescript",
    "express",
    "bullmq",
    "redis",
    "postgresql",
    "backend",
    "event-driven-architecture"
  ],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bullmq": "^6.4.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
